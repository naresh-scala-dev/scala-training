# Assets
GET           /assets/*file                                   controllers.Assets.versioned(path="/public", file: Asset)
GET           /favicon.png                                    controllers.Assets.at(path="/public", file="favicon.png")
GET           /                                               controllers.HomeController.index

# Authentication
POST          /api/login                                      controllers.AuthController.login

# EventUser (Users) Management
GET           /api/event-users                                controllers.EventUserController.getAllUsers
GET           /api/event-users/:id                            controllers.EventUserController.getUser(id: Long)
POST          /api/event-users/create                          controllers.EventUserController.createUser
PUT           /api/event-users/:id                             controllers.EventUserController.updateUser(id: Long)
DELETE        /api/event-users/:id                             controllers.EventUserController.deleteUser(id: Long)

# Events
GET           /api/events                                     controllers.EventController.getAllEvents
GET           /api/events/:id                                 controllers.EventController.getEvent(id: Long)
POST          /api/events/create                               controllers.EventController.createEvent
PUT           /api/events/:id                                  controllers.EventController.updateEvent(id: Long)
DELETE        /api/events/:id                                  controllers.EventController.deleteEvent(id: Long)

# Teams
GET           /api/teams                                        controllers.TeamController.getAllTeams
GET           /api/teams/:id                                     controllers.TeamController.getTeam(id: Long)
POST          /api/teams/create                                controllers.TeamController.createTeam
PUT           /api/teams/:id                                   controllers.TeamController.updateTeam(id: Long)
DELETE        /api/teams/:id                                   controllers.TeamController.deleteTeam(id: Long)

# Assign Users to Team
POST          /api/teams/assign-users                          controllers.TeamController.assignUsersToTeam

# Remove users from a team
POST            /api/teams/assign/remove                         controllers.TeamController.removeUserFromTeam


# Tasks
GET           /api/tasks                                      controllers.TaskController.getAllTasks
GET           /api/tasks/:id                                  controllers.TaskController.getTask(id: Long)
POST          /api/tasks/create                                controllers.TaskController.createTask
PUT           /api/tasks/:id                                   controllers.TaskController.updateTask(id: Long)
DELETE        /api/tasks/:id                                   controllers.TaskController.deleteTask(id: Long)

